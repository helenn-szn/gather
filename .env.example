# Copy to .env on the Sprite and fill in.
# No API keys here: these are connector gateway URLs, which only work from
# inside a Sprite the connector allows. Get them from:
#   python3 -m scripts.check_connectors

AGENTMAIL_GATEWAY=https://api.sprites.dev/v1/gateway/<provider>/<connection_id>
TELEGRAM_GATEWAY=https://api.sprites.dev/v1/gateway/<provider>/<connection_id>
OPENROUTER_GATEWAY=https://api.sprites.dev/v1/gateway/openrouter/<connection_id>
OPENROUTER_CHAT_PATH=/v1/chat/completions

# Gather's own inbox (create it in the AgentMail console)
AGENTMAIL_INBOX=uncle-gather@agentmail.to

# Used only by the Thursday smoke test
TEST_GUEST_EMAIL=you@example.com
HOST_NAME=Helen
GATHER_EVENT=Christmas dinner at Helen's home, Saturday 20 December, 6 p.m.

GATHER_MODEL=openai/gpt-4o-mini

# Friday: live agent
# Secret for the dashboard: open https://<sprite-url>/?key=<this>
# Make it long and random, e.g. run: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
DASHBOARD_KEY=change-me
# Optional; looked up from Telegram if empty
TELEGRAM_BOT_USERNAME=unclegather_bot
# How long before Uncle Gus chases a silent guest. 1440 = 24 hours.
# Use 3 for the demo so you can watch it happen.
FOLLOWUP_AFTER_MINUTES=1440
MAX_FOLLOWUPS=2
MAX_MESSAGES_PER_GUEST_PER_HOUR=6
POLL_SECONDS=10

# Pinecone memory across events (optional). Gateway URL of the Pinecone
# connector; the index needs integrated embedding on the field below.
# Built-in Pinecone connector: set PINECONE_INDEX (records API).
# Custom connector pointed at an index host: leave PINECONE_INDEX empty.
PINECONE_GATEWAY=
PINECONE_INDEX=gather-guests
PINECONE_NAMESPACE=gather-guests
PINECONE_TEXT_FIELD=chunk_text

# Policy gate (optional, recommended). On the AGENT Sprite:
#   AGENTMAIL_GATEWAY=gate:agentmail
#   TELEGRAM_GATEWAY=gate:telegram
#   GATE_URL=https://gather-gate-xxxx.sprites.app
# On BOTH Sprites, the same long random secret:
GATE_SECRET=
